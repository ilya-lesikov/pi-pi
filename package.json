{
  "name": "@ilya-lesikov/pi-pi",
  "version": "1.15.0",
  "description": "Pi-Pi: a persistent, general-purpose Pi agent with adaptive tools, workers, skills, and memory",
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "general-purpose",
    "skills",
    "subagents"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilya-lesikov/pi-pi.git"
  },
  "files": [
    "extensions/",
    "scripts/lib/"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "bash scripts/test-package.sh",
    "test:all": "vitest run && bash scripts/test-package.sh",
    "release:bb-plugin": "bash scripts/release-bb-plugin.sh",
    "coverage": "vitest run --coverage"
  },
  "pi": {
    "extensions": [
      "./extensions/orchestrator"
    ]
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.64",
    "@pierre/diffs": "^1.2.0",
    "minimatch": "^10.0.0",
    "pino": "^10.3.1",
    "proper-lockfile": "^4.1.2",
    "turndown": "^7.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@sinclair/typebox": "^0.34.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typebox": "^1.3.7",
    "typescript": "^5.8.0",
    "vitest": "^4.1.4"
  }
}
